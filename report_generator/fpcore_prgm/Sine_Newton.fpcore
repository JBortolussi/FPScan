(FPCore
 (x0)
 :name
 "Sine_Newton"
 :fpbench-domain
 mathematics
 :pre
 (< -1 x0 1)
 (while
  (< i 10)
  ((x
    x0
    (-
     x
     (/
      (+ (+ (- x (/ (pow x 3) 6)) (/ (pow x 5) 120)) (/ (pow x 7) 5040))
      (+ (+ (- 1 (/ (* x x) 2)) (/ (pow x 4) 24)) (/ (pow x 6) 720)))))
   (i 0 (+ i 1)))
  x))