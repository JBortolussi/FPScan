(FPCore
 (t0 w0 N)
 :name
 "Pendulum"
 :fpbench-domain
 science
 :pre
 (and (< -2 t0 2) (< -5 w0 5))
 :example
 ((N 1000))
 (let ((h 1/100) (L 2) (m 3/2) (g 196133/20000))
   (while
    (< n N)
    ((t
      t0
      (let ((k1w (* (/ (- g) L) (sin t))))
        (let ((k2t (+ w (* (/ h 2) k1w)))) (+ t (* h k2t)))))
     (w
      w0
      (let ((k2w (* (/ (- g) L) (sin (+ t (* (/ h 2) w)))))) (+ w (* h k2w))))
     (n 0 (+ n 1)))
    t)))