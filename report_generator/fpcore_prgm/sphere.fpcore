(FPCore
 (x r lat lon)
 :name
 "sphere"
 :cite
 (solovyev-et-al-2015)
 :precision
 binary64
 :pre
 (and (<= -10 x 10)
      (<= 0 r 10)
      (<= -392699/250000 lat 392699/250000)
      (<= -62831853/20000000 lon 62831853/20000000))
 (let ((sinLat (sin lat)) (cosLon (cos lon))) (+ x (* (* r sinLat) cosLon))))