(FPCore
 (a b c)
 :name
 "triangle7"
 :cite
 (darulova-kuncak-2014)
 :pre
 (and (<= 1 a 9)
      (<= 1 b 9)
      (<= 1 c 9)
      (> (+ a b) (+ c 1/10000000))
      (> (+ a c) (+ b 1/10000000))
      (> (+ b c) (+ a 1/10000000)))
 (let ((s (/ (+ (+ a b) c) 2))) (sqrt (* (* (* s (- s a)) (- s b)) (- s c)))))