*added modules /MapNode/ and /MapIndNode/ in added file /Results/
module MapNode = Map.Make (struct type t = Location.t * Name.t let compare = compare end)
module MapIndNode = Map.Make (struct type t = (Location.t * int * Name.t) let compare = compare end)
Results : used
Same maps as Results.Map and Results.MapInd but with the name of the node concerned more.
Useful to register separately each value associated to a same location in each context (tree of node calls), the name contains the context.



*added module /Register/ and /ResultRegister/ in added file /Results/
module type Register =
  sig
    module Dom: Relational.Domain
    type t
    val empty : t
    val register : ?unroll:int -> Location.t -> Dom.t -> t -> t
    val register_subnode : t -> t -> Name.t -> t
    val find_aopt : Name.t option -> Location.t ->  t -> Dom.t option
    val get_unrolled_info: Name.t option -> t -> Location.t -> (int * Dom.t) list
  end
module ResultRegister (Dom : Relational.Domain) : Register
Analyze, PrintResults, Main : used
Use to register analysis results.

Module Dom
relational abstract domain chosen for the analysis

type t = Dom.t Map.t * Dom.t MapInd.t * Dom.t MapNode.t * Dom.t MapIndNode.t
type of the register, four maps containing a domain associated to a location

val empty : t
Analyze : used
returns an empty register = Map.empty, MapInd.empty, MapNode.empty, MapIndNode.empty

val register : ?unroll:int -> Location.t -> Dom.t -> t -> t
Analyze : used
intern function register of function analyze in file Analyze moved and updated to feet with type t

val register_subnode : t -> t -> Name.t -> t
Analyze : used
register_subnode r1 r2 name returns r1 in which every values of r2 are set into MapNode and MapIndNode thanks to name
Function register_subnode works like a merge function to merge results of sub-node analysis to results of node caller analysis.
examples :
 r1 = {(l1, dom1)} * {((l1,1), dom2)} * {((l2,n1),dom3)} * {((l2,1,n1),dom4)}  r2 = {(l2,dom5)} * {((l2,1), dom6)} * {} * {}
 Register.register_subnode r1 r2 n2 = r3 with r3 = {(l1,dom1)} * {((l1,1),dom2)} * {((l2,n1),dom3) ; ((l2,n2),dom5)} * {((l2,1,n1),dom4) ; ((l2,1,n2), dom6)}

 r1 = {(l1, dom1)} * {((l1,1), dom2)} * {((l2,n1),dom3)} * {((l2,1,n1),dom4)}  r2 = {(l2,dom5)} * {((l2,1), dom6)} * {((l3,n2),dom7)} * {((l3,1,n2),dom8)}
 Register.register_subnode r1 r2 n3 = r3 with r3 = {(l1,dom1)} * {((l1,1),dom2)} * {((l2,n1),dom3) ; ((l3,n2),dom7) ; ((l2,n3), dom5)} * {((l2,1,n1),dom4) ; ((l3,1,n2), dom8) ; ((l2,1,n3),dom6)}

val find_aopt : Name.t option -> Location.t ->  t -> Dom.t option
PrintResults : used
find_aopt None l r returns the domain associated to the location l
find_aopt Some(n) l r returns the domain associated to the location l and the name n
Function find_aopt works like a find function but the name indicate in which map the find should be done. Without a name, the first map of register r, with a name, the third map of r.
examples :
 r = {(l1,dom1)} * mi * {((l2,n), dom2) * mni
 Results.find_aopt None l1 r = Some (dom1)

 r = {(l1,dom1)} * mi * {((l2,n), dom2) * mni
 Results.find_aopt Some(n) l2 r = Some (dom2)

 r = {(l1,dom1)} * mi * {((l2,n), dom2) * mni
 Results.find_aopt None l3 r = None

 r = {(l1,dom1)} * mi * {((l2,n), dom2) * mni
 Results.find_aopt None l2 r = None

 r = {(l1,dom1)} * mi * {((l2,n), dom2) * mni
 Results.find_aopt Some(n) l1 r = None

val get_unrolled_info: Name.t option -> t -> Location.t -> (int * Dom.t) list
PrintResults : used
get_unrolled_info None r l returns the list of (integer, domains) associated to the location l
get_unrolled_info Some(n) r l returns the list of (integer, domains) associated to the location l and the name n
Function get_unrolled_info returns the domain associated to each turn of while loop. With a name, it looks for it in the fourth map of the register, without, in the second.
examples :
 r = m * {((l1,1),dom1) ; ((l2,1),dom2) ; ((l1,2),dom3)} * mn * {((l3,1,n1),dom4) ; ((l4,1,n2),dom5) ; ((l3,2,n3),dom6)}
 Results.get_unrolled_info None r l1 = [(1,dom1);(2,dom3)]

 r = m * {((l1,1),dom1) ; ((l2,1),dom2) ; ((l1,2),dom3)} * mn * {((l4,2,n2),dom4) ; ((l3,1,n1),dom5) ; ((l4,1,n2),dom6) ; ((l3,1,n3),dom7)}
 Results.get_unrolled_info Some(n1) r l4 = [(1,dom5)]

 r = m * {((l1,1),dom1) ; ((l2,1),dom2) ; ((l1,2),dom3)} * mn * {((l3,2,n2),dom4) ; ((l4,1,n1),dom5) ; ((l3,1,n2),dom6) ; ((l4,1,n3),dom7)}
 Results.get_unrolled_info Some(n2) r l3 = [(1,dom6);(2,dom4)]

 r = m * {((l1,1),dom1) ; ((l2,1),dom2) ; ((l1,2),dom3)} * mn * {((l4,2,n2),dom4) ; ((l3,1,n1),dom5) ; ((l4,1,n2),dom6) ; ((l3,1,n3),dom7)}
 Results.get_unrolled_info None r l3 = []



